{
  "name": "pbt-extension",
  "private": true,
  "publisher": "iog",
  "displayName": "PBT",
  "description": "",
  "icon": "images/pbt-logo.png",
  "version": "0.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/input-output-hk/sc-testing-tools-vs-extension.git"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "workspaces": [
    "server",
    "webview-ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pbt-extension.buildAllTestSuites",
        "title": "Refresh Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "pbt-extension.runAllTests",
        "title": "Run Tests",
        "icon": "$(run-all)"
      },
      {
        "command": "pbt-extension.refreshTestConfiguration",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pbt-extension.closeTestCoverage",
        "title": "Close",
        "icon": "$(close)"
      },
      {
        "command": "pbt-extension.collapseAllTestCoverage",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pbt-extension.buildAllTestSuites",
          "when": "view == pbt-test-tree",
          "group": "navigation@1"
        },
        {
          "command": "pbt-extension.runAllTests",
          "when": "view == pbt-test-tree",
          "group": "navigation@2"
        },
        {
          "command": "pbt-extension.refreshTestConfiguration",
          "when": "view == pbt-test-run-configuration",
          "group": "navigation@1"
        },
        {
          "command": "pbt-extension.collapseAllTestCoverage",
          "when": "view == pbt-test-coverage",
          "group": "navigation@1"
        },
        {
          "command": "pbt-extension.closeTestCoverage",
          "when": "view == pbt-test-coverage",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "PBT Configuration",
      "type": "object",
      "properties": {
        "pbt-extension.executionMode": {
          "type": "string",
          "enum": [
            "docker",
            "nix"
          ],
          "default": "docker",
          "description": "Select the mode for executing commands with PBT."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pbt-test-tree",
          "title": "PBT",
          "icon": "images/pbt-icon.svg"
        }
      ]
    },
    "views": {
      "pbt-test-tree": [
        {
          "id": "pbt-test-tree",
          "name": "Test Panel",
          "type": "webview",
          "icon": "images/pbt-icon.svg"
        },
        {
          "id": "pbt-test-coverage",
          "name": "Plinth Script Coverage",
          "type": "webview",
          "icon": "images/pbt-icon.svg"
        },
        {
          "id": "pbt-test-run-configuration",
          "name": "Test Run Configuration",
          "type": "webview",
          "icon": "images/pbt-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:server && npm run compile:webview",
    "compile:extension": "tsc -p ./",
    "compile:server": "npm run build -w server",
    "compile:webview": "npm run build -w webview-ui"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.118.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "ajv": "^8.20.0",
    "async": "^3.2.6",
    "rxdb": "^17.4.0",
    "tree-sitter-haskell": "^0.23.1",
    "vscode-jsonrpc": "^8.2.1",
    "web-tree-sitter": "^0.26.11"
  }
}
